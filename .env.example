# 复制为项目根目录的 .env 后填写；程序启动时自动读取 .env，
# 已存在的系统环境变量优先于 .env 中的同名项。

# 必填：OpenAI 兼容接口的 key
OPENAI_API_KEY=replace-me

# 可选：兼容端点（不填则用 OpenAI 官方地址）
OPENAI_BASE_URL=https://api.openai.com/v1

# 必填：模型名
DATA_AGENT_MODEL=gpt-4o-mini

# 可选：演示库路径（默认 <项目根>/data/demo.db）
# DATA_AGENT_DB_PATH=data/demo.db

# 可选：返回行数上限（默认 200）
# DATA_AGENT_MAX_ROWS=200

# 可选：单次查询超时秒数（默认 5）
# DATA_AGENT_QUERY_TIMEOUT=5
